{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/n8n-hooks.mjs\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__validate_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/n8n-hooks.mjs\" pre-validate-workflow",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__create_workflow_from_code$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/n8n-hooks.mjs\" pre-create-workflow",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__update_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/n8n-hooks.mjs\" pre-update-workflow",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__get_node_types$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/n8n-hooks.mjs\" pre-get-node-types",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__execute_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/n8n-hooks.mjs\" pre-execute-workflow",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__test_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/n8n-hooks.mjs\" pre-test-workflow",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*__validate_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/n8n-hooks.mjs\" post-validate-workflow",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
